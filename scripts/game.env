# This game's values for the shared scripts in sdk/scripts (sdk/scripts/common.sh lists each and its default)
GAME_XBE=default.xbe
GAME_LOG=pgr1            # GameInfo::log
GAME_TARGET=PGR1         # the add_xbe_image target in CMakeLists.txt
GHIDRA_PROJECT=pgr1
SMOKE_PAD=scripts/pad/race.txt
SMOKE_MENU=              # none: PGR1's menus show 3D cars (600 to 900 draws a frame), so the 2D-menu check cannot apply
SOAK_PAD=                # a program printing a pad script for N seconds of races back to back
